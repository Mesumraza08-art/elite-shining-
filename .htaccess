# Hostinger (Apache/LiteSpeed) config for Elite Shine static site
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /index.html

# HTTPS redirect is left to hPanel → Security → SSL → Force HTTPS,
# which only applies once a certificate exists for the domain.

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/json
</IfModule>

# Caching: always revalidate HTML so updates show immediately
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
